# Copy to backend/.env and adjust for your environment.
# ``scripts/dev.sh`` sets Mailpit SMTP for the API process; use these same values if you start uvicorn manually.

DATABASE_URL=postgresql+psycopg2://spend:spend@127.0.0.1:15432/spend_integrity
REDIS_URL=redis://127.0.0.1:6379/0

# Links in org-invite and password-reset emails (Vite dev server).
AUTH_FRONTEND_BASE_URL=http://127.0.0.1:5173

# Local Mailpit (docker compose service ``mailpit``). Web UI: http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@spend-integrity.local

# Production: use your provider (often port 587 + SMTP_USE_TLS=true, or 465 + SSL).
# Leave SMTP_HOST empty only when you intentionally want emails logged to the API process.
