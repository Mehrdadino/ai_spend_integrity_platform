# Copy to backend/.env and adjust for your environment.
# ``scripts/dev.sh`` sets Mailpit SMTP for the API process; use these same values if you start uvicorn manually.

DATABASE_URL=postgresql+psycopg2://spend:spend@127.0.0.1:15432/spend_integrity
REDIS_URL=redis://127.0.0.1:6379/0

# Links in org-invite and password-reset emails (Vite dev server).
AUTH_FRONTEND_BASE_URL=http://127.0.0.1:5173

# Local Mailpit (docker compose service ``mailpit``). Web UI: http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@spend-integrity.local

# Production: use your provider (often port 587 + SMTP_USE_TLS=true, or 465 + SSL).
# Leave SMTP_HOST empty only when you intentionally want emails logged to the API process.
# SMTP_USER=
# SMTP_PASSWORD=

# Optional bill structuring. Leave the key empty for deterministic sample line items.
# Put a real key only in backend/.env (gitignored). Do not commit it.
EXTRACTION_LLM_API_KEY=
EXTRACTION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EXTRACTION_LLM_MODEL=gemini-2.5-flash

# Local S3 defaults match docker-compose.yml (MinIO). Override in production.
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio_minio_minio

# Production (see SECURITY.md). Dev warns and still starts with the weak JWT default.
# APP_ENV=production
# JWT_SECRET_KEY=
# AUTH_ALLOW_DEV_ORG_HEADER=false
# AUTH_ALLOW_REGISTRATION=false
# CORS_ORIGINS=https://your-app.example
